{
  "name": "@payguin/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for integrating with PayGuin PIX payment gateway — charge creation, order status, and webhook verification.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepare": "tsup",
    "version": "tsup && git add -A dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasishizawa/payguin-sdk-js.git"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "payguin",
    "pix",
    "payment",
    "webhook",
    "hmac",
    "sdk"
  ]
}
